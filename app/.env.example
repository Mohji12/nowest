# Copy to .env on the EC2 instance and fill in real values.
APP_ENV=production
HOST=0.0.0.0
PORT=8000
WORKERS=2
DEBUG=false

# Required: MySQL connection string (URL-encode special characters in password)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/nowest_interior

# Required: change these in production
SECRET_KEY=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string

# Optional auth/session tuning
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_MAX_AGE=604800

# AWS region for S3 portfolio lookups (use IAM role on EC2 when possible)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# File uploads
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=10485760
